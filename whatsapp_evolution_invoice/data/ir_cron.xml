<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_evo_whatsapp_queue" model="ir.cron">
        <field name="name">WhatsApp: send queued messages</field>
        <field name="model_id" ref="model_evo_whatsapp_message"/>
        <field name="state">code</field>
        <field name="code">model._cron_process_queue()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
    <record id="ir_cron_evo_whatsapp_triggers" model="ir.cron">
        <field name="name">WhatsApp: run template triggers (scheduled / document expiry)</field>
        <field name="model_id" ref="model_evo_whatsapp_template"/>
        <field name="state">code</field>
        <field name="code">model._cron_run_triggers()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">hours</field>
        <field name="active" eval="True"/>
    </record>
</odoo>
